import AdaptedPlaneJets

noncomputable section
open Set Filter MeasureTheory IsManifold
open scoped Topology ContDiff Manifold
namespace MinimizingSard.Five

private abbrev Field := State → State
private abbrev lie := VectorField.lieBracket (E := State) ℝ
variable {m : ℕ} {X : Fin m → Field} {q : State} {k l : ℕ} {A B : Field}

/-- Expressions near a point in smooth multiples of words of bounded order. -/
private inductive Expansion (X : Fin m → Field) (q : State) (k : ℕ) : Field → Prop
  | word (w : BracketWord m) (h : w.order ≤ k) : Expansion X q k (w.eval X)
  | add {V W} : Expansion X q k V → Expansion X q k W → Expansion X q k (V+W)
  | mul {a : State → ℝ} {V} : ContDiffAt ℝ ∞ a q → Expansion X q k V →
      Expansion X q k (fun z => a z • V z)
  | germ {V W} : V =ᶠ[𝓝 q] W → Expansion X q k W → Expansion X q k V

private theorem Expansion.mono (h : Expansion X q k A) (kl : k ≤ l) : Expansion X q l A := by
  induction h with
  | word w hw => exact .word w (hw.trans kl)
  | add _ _ ih jh => exact .add ih jh
  | mul ha _ ih => exact .mul ha ih
  | germ he _ ih => exact .germ he ih

private theorem word_smooth (cs : ∀ i, ContDiffAt ℝ ∞ (X i) q) (w : BracketWord m) :
    ContDiffAt ℝ ∞ (w.eval X) q := by
  induction w with
  | field i => exact cs i
  | bracket a b ha hb => exact ha.lieBracket_vectorField hb (by simp)

private theorem Expansion.smooth (h : Expansion X q k A) (cs : ∀ i, ContDiffAt ℝ ∞ (X i) q) :
    ContDiffAt ℝ ∞ A q := by
  induction h with
  | word w _ => exact word_smooth cs w
  | add _ _ ih jh => exact ih.add jh
  | mul ha _ ih => exact ha.smul ih
  | germ he _ ih => exact ih.congr_of_eventuallyEq he

private theorem Expansion.mem (h : Expansion X q k A) : A q ∈ wordLayer X q k := by
  induction h with
  | word w hw => exact Submodule.subset_span ⟨w,hw,rfl⟩
  | add _ _ ih jh => exact Submodule.add_mem _ ih jh
  | mul ha _ ih => exact Submodule.smul_mem _ _ ih
  | germ he _ ih => exact he.self_of_nhds.symm ▸ ih

private theorem near_diff {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] {f : State → F}
    (hf : ContDiffAt ℝ ∞ f q) : ∀ᶠ z in 𝓝 q, DifferentiableAt ℝ f z :=
  ((hf.of_le (show (1:WithTop ℕ∞) ≤ ∞ by simp)).eventually (by simp)).mono
    (fun _ hz => hz.differentiableAt le_rfl)

private theorem Expansion.right (cs : ∀ i, ContDiffAt ℝ ∞ (X i) q)
    (hB : Expansion X q l B) (cA : ContDiffAt ℝ ∞ A q)
    (atoms : ∀ w : BracketWord m, w.order ≤ l → Expansion X q k (lie A (w.eval X)))
    (lk : l ≤ k) : Expansion X q k (lie A B) := by
  induction hB with
  | word w hw => exact atoms w hw
  | add h j ih jh =>
    apply Expansion.germ _ (.add ih jh)
    filter_upwards [near_diff (h.smooth cs),near_diff (j.smooth cs)] with z hz jz
    exact VectorField.lieBracket_add_right hz jz
  | mul ha h ih =>
    apply Expansion.germ _ (.add (.mul ((ha.fderiv_right (by simp)).clm_apply cA) (h.mono lk)) (.mul ha ih))
    filter_upwards [near_diff ha,near_diff (h.smooth cs)] with z az vz
    exact VectorField.lieBracket_smul_right az vz
  | germ eq h ih => exact .germ (Filter.EventuallyEq.rfl.lieBracket_vectorField eq) ih

private theorem Expansion.bracket (cs : ∀ i, ContDiffAt ℝ ∞ (X i) q)
    (hA : Expansion X q k A) (hB : Expansion X q l B) : Expansion X q (k+l) (lie A B) := by
  induction hA with
  | word a ha =>
    apply hB.right cs (word_smooth cs a) _ (by omega)
    intro b hb
    exact .word (.bracket a b) (Nat.add_le_add ha hb)
  | add h j ih jh =>
    apply Expansion.germ _ (.add ih jh)
    filter_upwards [near_diff (h.smooth cs),near_diff (j.smooth cs)] with z hz jz
    exact VectorField.lieBracket_add_left hz jz
  | mul ha h ih =>
    apply Expansion.germ _ (.add (.mul (((ha.fderiv_right (by simp)).clm_apply (hB.smooth cs)).neg)
      (h.mono (by omega))) (.mul ha ih))
    filter_upwards [near_diff ha,near_diff (h.smooth cs)] with z az vz
    exact VectorField.lieBracket_fmul_left az vz
  | germ eq h ih => exact .germ (eq.lieBracket_vectorField Filter.EventuallyEq.rfl) ih


/-- Germs of smooth fields generated by local horizontal sections, their
Lie brackets, sums and smooth multiples. -/
inductive SectionLie (D : State → Submodule ℝ State) (q : State) : (State → State) → Prop
  | horizontal {V} : ContDiffAt ℝ ∞ V q → (∀ᶠ z in 𝓝 q, V z ∈ D z) → SectionLie D q V
  | add {V W} : SectionLie D q V → SectionLie D q W → SectionLie D q (V+W)
  | mul {a : State → ℝ} {V} : ContDiffAt ℝ ∞ a q → SectionLie D q V → SectionLie D q (fun z => a z • V z)
  | bracket {V W} : SectionLie D q V → SectionLie D q W → SectionLie D q (VectorField.lieBracket ℝ V W)

private def columns (X : Fin m → State → State) (z : State) : Fiber m →L[ℝ] State :=
  ∑ i, (ContinuousLinearMap.proj i).smulRight (X i z)

private theorem columns_apply (x : Fiber m) : columns X q x = ∑ i, x i • X i q := by
  simp [columns,ContinuousLinearMap.sum_apply]

private theorem section_in_expansion (hm : 0 < m) (reg : ∀ i, ContDiffAt ℝ ∞ (X i) q)
    (indep : LinearIndependent ℝ (fun i => X i q)) (V : State → State) (cv : ContDiffAt ℝ ∞ V q)
    (h : ∀ᶠ z in 𝓝 q, V z ∈ LinearMap.range (columns X z).toLinearMap) : Expansion X q 1 V := by
  classical
  have inj : Function.Injective (columns X q) := by
    intro a b eq
    apply indep.fintypeLinearCombination_injective
    simpa only [Fintype.linearCombination_apply,columns_apply] using eq
  obtain ⟨L0,hl⟩ := (columns X q).toLinearMap.exists_leftInverse_of_injective (LinearMap.ker_eq_bot.mpr inj)
  let L := L0.toContinuousLinearMap
  let B (z : State) := L.comp (columns X z)
  have bq : B q = 1 := ContinuousLinearMap.ext (fun a => DFunLike.congr_fun hl a)
  have cb : ContDiffAt ℝ ∞ B q := contDiffAt_const.clm_comp (ContDiffAt.sum (fun i _ => contDiffAt_const.smulRight (reg i)))
  let a (z : State) := Ring.inverse (B z) (L (V z))
  have inv : ContDiffAt ℝ ∞ Ring.inverse (B q) := bq ▸ contDiffAt_ringInverse ℝ 1
  have ca : ContDiffAt ℝ ∞ a q := (inv.comp q cb).clm_apply (L.contDiff.contDiffAt.comp q cv)
  have units : ∀ᶠ z in 𝓝 q, IsUnit (B z) := cb.continuousAt.tendsto (Units.isOpen.mem_nhds (bq.symm ▸ isUnit_one))
  have finite (I : Finset (Fin m)) : Expansion X q 1 (∑ i ∈ I, fun z => a z i • X i z) := by
    induction I using Finset.induction_on with
    | empty =>
      let j : Fin m := ⟨0,hm⟩
      simpa only [Finset.sum_empty] using (show Expansion X q 1 (0 : State → State) from
        Expansion.germ (by filter_upwards with z; simp) (Expansion.mul (contDiffAt_const (c := (0:ℝ))) (.word (.field j) le_rfl)))
    | insert i I hI ih =>
      rw [Finset.sum_insert hI]
      exact .add (.mul ((ContinuousLinearMap.proj i : Fiber m →L[ℝ] ℝ).contDiff.contDiffAt.comp q ca) (.word (.field i) le_rfl)) ih
  apply Expansion.germ _ (finite Finset.univ)
  filter_upwards [units,h] with z hz ⟨b,hb⟩
  have recovered : a z = b := by
    change Ring.inverse (B z) (L (V z)) = b
    rw [← hb]
    exact DFunLike.congr_fun (Ring.inverse_mul_cancel (B z) hz) b
  simp only [Finset.sum_apply,recovered]
  exact hb.symm.trans (columns_apply _)

/-- The entire Lie span of arbitrary smooth local horizontal sections
agrees with the span of the words in any smooth local basis. No
bracket-generation assumption is used to obtain this equivalence. -/
theorem section_lie_span_eq_frame_words {D : State → Submodule ℝ State}
    (hm : 0 < m) (reg : ∀ i, ContDiffAt ℝ ∞ (X i) q) (indep : LinearIndependent ℝ (fun i => X i q))
    (horizontal : ∀ᶠ z in 𝓝 q, D z = Submodule.span ℝ (range (fun i => X i z))) :
    Submodule.span ℝ {v | ∃ V, SectionLie D q V ∧ V q = v} =
      Submodule.span ℝ (range (fun w : BracketWord m => w.eval X q)) := by
  have ranges (z) : LinearMap.range (columns X z).toLinearMap = Submodule.span ℝ (range (fun i => X i z)) := by
    have eq : (columns X z).toLinearMap = Fintype.linearCombination ℝ (fun i => X i z) := LinearMap.ext (fun a => columns_apply a)
    rw [eq,Fintype.range_linearCombination]
  have expand {V} (hV : SectionLie D q V) : ∃ k, Expansion X q k V := by
    induction hV with
    | horizontal cv hv => exact ⟨1,section_in_expansion hm reg indep _ cv (by
        filter_upwards [horizontal,hv] with z hz h; rwa [ranges,← hz])⟩
    | add _ _ ih jh =>
      obtain ⟨k,hk⟩ := ih; obtain ⟨l,hl⟩ := jh
      exact ⟨max k l,.add (hk.mono (le_max_left ..)) (hl.mono (le_max_right ..))⟩
    | mul cs _ ih => obtain ⟨k,hk⟩ := ih; exact ⟨k,.mul cs hk⟩
    | bracket _ _ ih jh => obtain ⟨k,hk⟩ := ih; obtain ⟨l,hl⟩ := jh; exact ⟨k+l,hk.bracket reg hl⟩
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro v ⟨V,hV,rfl⟩
    obtain ⟨k,hk⟩ := expand hV
    exact (Submodule.span_mono (fun _ ⟨w,_,eq⟩ => ⟨w,eq⟩) : wordLayer X q k ≤ Submodule.span ℝ (range (fun w : BracketWord m => w.eval X q))) hk.mem
  · apply Submodule.span_mono
    rintro v ⟨w,rfl⟩
    refine ⟨w.eval X,?_,rfl⟩
    induction w with
    | field i => exact .horizontal (reg i) (horizontal.mono fun z hz => hz.symm ▸ Submodule.subset_span (mem_range_self i))
    | bracket a b ih jh => exact .bracket ih jh

#print axioms section_lie_span_eq_frame_words

variable {M : Type*} [TopologicalSpace M] [ChartedSpace State M]

private abbrev synth (e : Frame M 2) (z : State) : Fiber 2 →L[ℝ] State :=
  (ContinuousLinearMap.proj (0 : Fin 2)).smulRight (e.X 0 z) +
    (ContinuousLinearMap.proj (1 : Fin 2)).smulRight (e.X 1 z)

private theorem synth_apply (e : Frame M 2) (z : State) (a : Fiber 2) :
    synth e z a = e.velocity z a := by
  simp [synth,Frame.velocity,Fin.sum_univ_two]

private theorem horizontal_expansion (e : Frame M 2) {z : State} (inside : z ∈ e.chart.target)
    (V : Field) (cv : ContDiffAt ℝ ∞ V z)
    (h : ∀ᶠ p in 𝓝 z, ∃ a : Fiber 2, synth e p a = V p) : Expansion e.X z 1 V := by
  have cs (i) := (e.smooth i z inside).contDiffAt (e.chart.open_target.mem_nhds inside)
  have inj : Function.Injective (synth e z) := by
    intro a b eq
    apply (e.independent z inside).fintypeLinearCombination_injective
    simpa only [Fintype.linearCombination_apply,synth_apply,Frame.velocity] using eq
  obtain ⟨L0,hl⟩ := (synth e z).toLinearMap.exists_leftInverse_of_injective (LinearMap.ker_eq_bot.mpr inj)
  let L := L0.toContinuousLinearMap
  let T (p : State) := L.comp (synth e p)
  have atZ : T z = 1 := ContinuousLinearMap.ext fun a => DFunLike.congr_fun hl a
  have reg : ContDiffAt ℝ ∞ T z :=
    contDiffAt_const.clm_comp ((contDiffAt_const.smulRight (cs 0)).add (contDiffAt_const.smulRight (cs 1)))
  let a (p : State) := Ring.inverse (T p) (L (V p))
  have invReg : ContDiffAt ℝ ∞ Ring.inverse (T z) := by
    rw [atZ]; exact contDiffAt_ringInverse ℝ 1
  have ca : ContDiffAt ℝ ∞ a z := (invReg.comp z reg).clm_apply (L.contDiff.contDiffAt.comp z cv)
  have unit : ∀ᶠ p in 𝓝 z, IsUnit (T p) := reg.continuousAt.tendsto
    (Units.isOpen.mem_nhds (show IsUnit (T z) by rw [atZ]; exact isUnit_one))
  let T₀ := (ContinuousLinearMap.proj (0 : Fin 2) : Fiber 2 →L[ℝ] ℝ)
  let T₁ := (ContinuousLinearMap.proj (1 : Fin 2) : Fiber 2 →L[ℝ] ℝ)
  apply Expansion.germ _ (.add (.mul (T₀.contDiff.contDiffAt.comp z ca) (.word (.field 0) le_rfl))
    (.mul (T₁.contDiff.contDiffAt.comp z ca) (.word (.field 1) le_rfl)))
  filter_upwards [unit,h] with p hp ⟨b,hb⟩
  have recover : a p = b := by
    change Ring.inverse (T p) (L (V p)) = b
    rw [← hb]
    exact DFunLike.congr_fun (Ring.inverse_mul_cancel (T p) hp) b
  change V p = a p 0 • e.X 0 p + a p 1 • e.X 1 p
  rw [recover,← hb]
  rfl

private theorem overlap_smooth (b e : Frame M 2) :
    ContDiffOn ℝ ∞ (e.chart ∘ b.chart.symm) (b.chart.symm.trans e.chart).source := by
  have h := (IsManifold.compatible_of_mem_maximalAtlas b.compatible e.compatible).1
  change ContDiffOn ℝ ∞ _ ((b.chart.symm.trans e.chart).source ∩ range (𝓘(ℝ,State))) at h
  simpa using h

variable [IsManifold 𝓘(ℝ,State) ∞ M]

private theorem pulled_words (Γ : Geometry M 2) (e b : Frame M 2) (he : e ∈ Γ.frames) (hb : b ∈ Γ.frames)
    (z : State) (hz : z ∈ (b.chart.symm.trans e.chart).source) (w : BracketWord 2) :
    Expansion b.X z w.order (VectorField.pullback ℝ (e.chart ∘ b.chart.symm) (w.eval e.X)) := by
  let F := e.chart ∘ b.chart.symm
  let U := (b.chart.symm.trans e.chart).source
  have cs (i) := (b.smooth i z hz.1).contDiffAt (b.chart.open_target.mem_nhds hz.1)
  have cF (p) (hp : p ∈ U) : ContDiffAt ℝ ∞ F p :=
    ((overlap_smooth b e) p hp).contDiffAt ((b.chart.symm.trans e.chart).open_source.mem_nhds hp)
  have cE (p) (hp : p ∈ U) (i) : ContDiffAt ℝ ∞ (e.X i) (F p) :=
    (e.smooth i _ (e.chart.map_source hp.2)).contDiffAt
      (e.chart.open_target.mem_nhds (e.chart.map_source hp.2))
  have inv (p) (hp : p ∈ U) : (fderiv ℝ F p).IsInvertible := by
    have hi := ContinuousLinearMap.IsInvertible.of_inverse
      (transition_left e.chart b.chart e.compatible b.compatible (b.chart.symm p) hp.2 (b.chart.map_target hp.1))
      (transition_left b.chart e.chart b.compatible e.compatible (b.chart.symm p) (b.chart.map_target hp.1) hp.2)
    simpa only [F,b.chart.right_inv hp.1] using hi
  induction w with
  | field i =>
    apply horizontal_expansion b hz.1
    · exact (((inv z hz).contDiffAt_map_inverse.comp z ((cF z hz).fderiv_right (by simp))).clm_apply
        ((cE z hz i).comp z (cF z hz)))
    · filter_upwards [(b.chart.symm.trans e.chart).open_source.mem_nhds hz] with p hp
      obtain ⟨T,matchT⟩ := Γ.overlap b hb e he (b.chart.symm p) ⟨b.chart.map_target hp.1,hp.2⟩
      let a : Fiber 2 := Pi.single i 1
      refine ⟨T.symm a,?_⟩
      rw [synth_apply]
      apply Eq.symm
      apply (inv p hp).inverse_apply_eq.mpr
      have hit := (matchT (T.symm a)).2
      rw [T.apply_symm_apply,b.chart.right_inv hp.1] at hit
      exact (by simpa [a,Frame.velocity,Pi.single_apply,ite_smul,F] using hit.symm)
  | bracket a d ha hd =>
    apply Expansion.germ _ (ha.bracket cs hd)
    filter_upwards [(b.chart.symm.trans e.chart).open_source.mem_nhds hz] with p hp
    exact VectorField.pullback_lieBracket (n := 2) (by simp) ((cF p hp).of_le (by decide))
      ((word_smooth (cE p hp) a).differentiableAt (by simp))
      ((word_smooth (cE p hp) d).differentiableAt (by simp))


omit [IsManifold 𝓘(ℝ,State) ∞ M] in
theorem transition_chain (a b c : OpenPartialHomeomorph M State)
    (ha : a ∈ maximalAtlas 𝓘(ℝ,State) ∞ M) (hb : b ∈ maximalAtlas 𝓘(ℝ,State) ∞ M)
    (hc : c ∈ maximalAtlas 𝓘(ℝ,State) ∞ M) (y : M)
    (ay : y ∈ a.source) (by' : y ∈ b.source) (cy : y ∈ c.source) :
    (fderiv ℝ (c ∘ b.symm) (b y)).comp (fderiv ℝ (b ∘ a.symm) (a y)) =
      fderiv ℝ (c ∘ a.symm) (a y) := by
  let F := b ∘ a.symm
  have center : F (a y) = b y := by simp [F,a.left_inv ay]
  have regular := (transition_smooth (k := 1) a b ha hb y ay by').differentiableAt (by decide)
  have next := (transition_smooth (k := 1) b c hb hc y by' cy).differentiableAt (by decide)
  have mem : a y ∈ (a.symm.trans b).source := ⟨a.map_source ay,by change a.symm (a y) ∈ b.source; rwa [a.left_inv ay]⟩
  have same : ((c ∘ b.symm) ∘ F) =ᶠ[𝓝 (a y)] (c ∘ a.symm) := by
    filter_upwards [(a.symm.trans b).open_source.mem_nhds mem] with z hz
    exact congrArg c (b.left_inv hz.2)
  have next' : DifferentiableAt ℝ (c ∘ b.symm) (F (a y)) := center.symm ▸ next
  have df := fderiv_comp (a y) next' (show DifferentiableAt ℝ F (a y) from regular)
  rw [center] at df
  exact df.symm.trans same.fderiv_eq

private theorem map_layer_le (Γ : Geometry M 2) (e b : Frame M 2) (he : e ∈ Γ.frames) (hb : b ∈ Γ.frames)
    (y : M) (ey : y ∈ e.chart.source) (by' : y ∈ b.chart.source) (k : ℕ) :
    (wordLayer e.X (e.chart y) k).map (fderiv ℝ (b.chart ∘ e.chart.symm) (e.chart y)).toLinearMap ≤
      wordLayer b.X (b.chart y) k := by
  apply Submodule.map_le_iff_le_comap.mpr
  apply Submodule.span_le.mpr
  rintro _ ⟨w,ord,rfl⟩
  have inside : b.chart y ∈ (b.chart.symm.trans e.chart).source :=
    ⟨b.chart.map_source by',by change b.chart.symm (b.chart y) ∈ e.chart.source; rwa [b.chart.left_inv by']⟩
  have mem := ((pulled_words Γ e b he hb _ inside w).mono ord).mem
  have inv := ContinuousLinearMap.inverse_eq
    (transition_left e.chart b.chart e.compatible b.compatible y ey by')
    (transition_left b.chart e.chart b.compatible e.compatible y by' ey)
  simpa only [VectorField.pullback,inv,Function.comp_apply,b.chart.left_inv by'] using mem

/-- On an overlap the full bracket filtration in any smooth target chart
is independent of the choice of the original rank-two orthonormal frame. -/
theorem frame_word_layer_invariant (Γ : Geometry M 2) (e b : Frame M 2) (he : e ∈ Γ.frames)
    (hb : b ∈ Γ.frames) (c : OpenPartialHomeomorph M State) (hc : c ∈ maximalAtlas 𝓘(ℝ,State) ∞ M)
    (y : M) (ey : y ∈ e.chart.source) (by' : y ∈ b.chart.source) (cy : y ∈ c.source) (k : ℕ) :
    (wordLayer e.X (e.chart y) k).map (fderiv ℝ (c ∘ e.chart.symm) (e.chart y)).toLinearMap =
    (wordLayer b.X (b.chart y) k).map (fderiv ℝ (c ∘ b.chart.symm) (b.chart y)).toLinearMap := by
  have one (s t : Frame M 2) (hs : s ∈ Γ.frames) (ht : t ∈ Γ.frames)
      (sy : y ∈ s.chart.source) (ty : y ∈ t.chart.source) :
      (wordLayer s.X (s.chart y) k).map (fderiv ℝ (c ∘ s.chart.symm) (s.chart y)).toLinearMap ≤
      (wordLayer t.X (t.chart y) k).map (fderiv ℝ (c ∘ t.chart.symm) (t.chart y)).toLinearMap := by
    have h := Submodule.map_mono (f := (fderiv ℝ (c ∘ t.chart.symm) (t.chart y)).toLinearMap)
      (map_layer_le Γ s t hs ht y sy ty k)
    rw [← Submodule.map_comp] at h
    rw [← transition_chain s.chart t.chart c s.compatible t.compatible hc y sy ty cy]
    exact h
  exact le_antisymm (one e b he hb ey by') (one b e hb he by' ey)

#print axioms frame_word_layer_invariant


/-- A fixed finite list spanning the third layer for every rank-two frame. -/
def thirdWord : Fin 5 → BracketWord 2 :=
  let x : BracketWord 2 := .field 0
  let y : BracketWord 2 := .field 1
  let b : BracketWord 2 := .bracket x y
  ![x,y,b,.bracket x b,.bracket y b]

private theorem third_list (X : Fin 2 → Field) (z : State) :
    Submodule.span ℝ (range fun i => (thirdWord i).eval X z) = wordLayer X z 3 := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨i,rfl⟩
    exact Submodule.subset_span ⟨thirdWord i,by fin_cases i <;> decide,rfl⟩
  · rw [← frame_third_layer_eq_words]
    apply Submodule.span_le.mpr
    rintro _ ((⟨i,rfl⟩ | eq) | ⟨i,rfl⟩)
    · fin_cases i
      · exact Submodule.subset_span ⟨0,rfl⟩
      · exact Submodule.subset_span ⟨1,rfl⟩
    · exact eq ▸ Submodule.subset_span ⟨2,rfl⟩
    · fin_cases i
      · exact Submodule.subset_span ⟨3,rfl⟩
      · exact Submodule.subset_span ⟨4,rfl⟩

private theorem third_dim (b : Frame M 2) (c : OpenPartialHomeomorph M State)
    (hc : c ∈ maximalAtlas 𝓘(ℝ,State) ∞ M) (y : M) (by' : y ∈ b.chart.source) (cy : y ∈ c.source) :
    Module.finrank ℝ (chartThirdLayer b c y) = Module.finrank ℝ (wordLayer b.X (b.chart y) 3) := by
  obtain ⟨T,eq⟩ := ContinuousLinearMap.IsInvertible.of_inverse
    (transition_left c b.chart hc b.compatible y cy by') (transition_left b.chart c b.compatible hc y by' cy)
  unfold chartThirdLayer
  rw [← eq]
  exact T.toLinearEquiv.finrank_map_eq _

/-- A countable set of reference frames is chosen before the center, terminal
frame and endpoint range. Five predetermined smooth word fields per reference
frame suffice to find a third-layer direction outside every rank-three range. -/
theorem ae_countable_reference_directions (Γ : Geometry M 2) (c : OpenPartialHomeomorph M State)
    (hc : c ∈ maximalAtlas 𝓘(ℝ,State) ∞ M) :
    ∃ T : Set Γ.frames, T.Countable ∧ ∀ᵐ q : State, q ∈ c.target →
      let y := c.symm q
      ∃ b ∈ T, y ∈ b.val.chart.source ∧
        ∀ (e : Frame M 2), e ∈ Γ.frames → y ∈ e.chart.source →
          4 ≤ Module.finrank ℝ (wordLayer e.X (e.chart y) 3) ∧
          ∀ W : Submodule ℝ State, Module.finrank ℝ W ≤ 3 →
            ∃ i : Fin 5,
              let v := (fderiv ℝ (c ∘ b.val.chart.symm) (b.val.chart y)) ((thirdWord i).eval b.val.X (b.val.chart y))
              v ∈ chartThirdLayer e c y ∧ v ∉ W := by
  let U (e : Γ.frames) := (c.symm.trans e.val.chart).source
  have covers (q) (hq : q ∈ c.target) : q ∈ ⋃ e, U e := by
    obtain ⟨e,he,inside⟩ := Γ.cover (c.symm q)
    exact mem_iUnion.mpr ⟨⟨e,he⟩,hq,inside⟩
  obtain ⟨T,count,cov⟩ := (IsLindelof.of_coe : IsLindelof c.target).elim_countable_subcover
    U (fun e => (c.symm.trans e.val.chart).open_source) covers
  refine ⟨T,count,?_⟩
  letI : Countable T := count.to_subtype
  have good (b : Γ.frames) : ∀ᵐ q : State, q ∈ U b →
      4 ≤ Module.finrank ℝ (wordLayer b.val.X (b.val.chart (c.symm q)) 3) := by
    apply ae_chart_overlap b.val.chart c b.val.compatible hc
      (fun p => 4 ≤ Module.finrank ℝ (wordLayer b.val.X p 3))
    exact (ae_frame_step_four b.val).mono fun _ h inside => (h inside).2.1
  filter_upwards [ae_all_iff.mpr (fun b : T => good b.val)] with q all
  intro hq y
  obtain ⟨b,hit⟩ := mem_iUnion.mp (cov hq)
  obtain ⟨bt,inside⟩ := mem_iUnion.mp hit
  have by' : y ∈ b.val.chart.source := inside.2
  have cy : y ∈ c.source := c.map_target hq
  have large : 4 ≤ Module.finrank ℝ (chartThirdLayer b.val c y) := by
    rw [third_dim b.val c hc y by' cy]
    exact all ⟨b,bt⟩ inside
  refine ⟨b,bt,by',?_⟩
  intro e he ey
  have same : chartThirdLayer b.val c y = chartThirdLayer e c y :=
    frame_word_layer_invariant Γ b.val e b.property he c hc y by' ey cy 3
  refine ⟨by rwa [← third_dim e c hc y ey cy,← same],?_⟩
  intro W dim
  let D := fderiv ℝ (c ∘ b.val.chart.symm) (b.val.chart y)
  let v (i : Fin 5) := D ((thirdWord i).eval b.val.X (b.val.chart y))
  have span : Submodule.span ℝ (range v) = chartThirdLayer b.val c y := by
    unfold chartThirdLayer
    rw [← third_list,Submodule.map_span,← range_comp]
    rfl
  have out : ∃ i, v i ∉ W := by
    by_contra! nope
    have incl : chartThirdLayer b.val c y ≤ W := by
      rw [← span]
      exact Submodule.span_le.mpr (by rintro _ ⟨i,rfl⟩; exact nope i)
    have := Submodule.finrank_mono incl
    omega
  obtain ⟨i,hi⟩ := out
  exact ⟨i,by rw [← same,← span]; exact Submodule.subset_span ⟨i,rfl⟩,hi⟩

#print axioms ae_countable_reference_directions


/-- The derivative of this chart sends the chosen field to a coordinate
direction on the entire chart source inside the reference frame. -/
def StraightensWord (b : Frame M 2) (i : Fin 5) (a : OpenPartialHomeomorph M State) : Prop :=
  ∀ y ∈ a.source, y ∈ b.chart.source ∧ ∃ j : Fin 5,
    fderiv ℝ (a ∘ b.chart.symm) (b.chart y) ((thirdWord i).eval b.X (b.chart y)) = Pi.single j 1

omit [IsManifold 𝓘(ℝ,State) ∞ M] in
/-- Compress all compatible straightening charts for the countable reference
fields inside one measuring chart. Coverage here is exact on the union of
the supplied local flow boxes, even when the witnesses vary uncountably. -/
theorem countable_straightening_subcover (Γ : Geometry M 2) (c : OpenPartialHomeomorph M State)
    (T : Set Γ.frames) (count : T.Countable) :
    ∃ S : Set (OpenPartialHomeomorph M State), S.Countable ∧
      (∀ a ∈ S, a ∈ maximalAtlas 𝓘(ℝ,State) ∞ M) ∧
      ∀ b ∈ T, ∀ i : Fin 5, ∀ y ∈ c.source,
        (∃ a ∈ maximalAtlas 𝓘(ℝ,State) ∞ M, y ∈ a.source ∧ StraightensWord b.val i a) →
        ∃ a ∈ S, y ∈ a.source ∧ StraightensWord b.val i a := by
  classical
  letI : Countable T := count.to_subtype
  let C (b : T) (i : Fin 5) := {a : OpenPartialHomeomorph M State //
    a ∈ maximalAtlas 𝓘(ℝ,State) ∞ M ∧ StraightensWord b.val.val i a}
  let V (b : T) (i : Fin 5) (a : C b i) := (c.symm.trans a.val).source
  have sub (b : T) (i : Fin 5) : ∃ R : Set (C b i), R.Countable ∧
      (⋃ a, V b i a) ⊆ ⋃ a ∈ R, V b i a :=
    (IsLindelof.of_coe : IsLindelof (⋃ a, V b i a)).elim_countable_subcover
      (V b i) (fun a => (c.symm.trans a.val).open_source) (Subset.rfl)
  choose R cr cov using sub
  let S := ⋃ b : T, ⋃ i : Fin 5, Subtype.val '' R b i
  refine ⟨S,countable_iUnion (fun b => countable_iUnion fun i => (cr b i).image _),?_,?_⟩
  · intro a ha
    obtain ⟨b,ha⟩ := mem_iUnion.mp ha
    obtain ⟨i,r,_,rfl⟩ := mem_iUnion.mp ha
    exact r.property.1
  · intro b bt i y cy localBox
    obtain ⟨a,ha,ay,rect⟩ := localBox
    let b' : T := ⟨b,bt⟩
    let a' : C b' i := ⟨a,ha,rect⟩
    have hit : c y ∈ V b' i a' := ⟨c.map_source cy,by change c.symm (c y) ∈ a.source; rwa [c.left_inv cy]⟩
    obtain ⟨r,hr⟩ := mem_iUnion.mp (cov b' i (mem_iUnion.mpr ⟨a',hit⟩))
    obtain ⟨rt,inside⟩ := mem_iUnion.mp hr
    exact ⟨r.val,mem_iUnion.mpr ⟨b',mem_iUnion.mpr ⟨i,⟨r,rt,rfl⟩⟩⟩,
      (c.left_inv cy) ▸ (show c.symm (c y) ∈ r.val.source from inside.2),r.property.2⟩

#print axioms countable_straightening_subcover


/-- The local coordinate construction isolated from the measure and path
arguments. The equality in a straightening chart holds on its whole source. -/
def LocalWordStraightening (Γ : Geometry M 2) : Prop :=
  ∀ b ∈ Γ.frames, ∀ i : Fin 5, ∀ y ∈ b.chart.source, (thirdWord i).eval b.X (b.chart y) ≠ 0 →
    ∃ a ∈ maximalAtlas 𝓘(ℝ,State) ∞ M, y ∈ a.source ∧ StraightensWord b i a

set_option maxHeartbeats 1800000 in
/-- Reduction of the rank-three endpoint branch to local straightening of
five explicit smooth fields. The witness needs no prescribed axis, bracket
growth, terminal segment, countable chart family, or length multiplier. -/
theorem ae_corank_two_of_local_straightening (Γ : Geometry M 2) (rect : LocalWordStraightening Γ)
    (x : M) (c : OpenPartialHomeomorph M State) (hc : c ∈ maximalAtlas 𝓘(ℝ,State) ∞ M) :
    ∀ᵐ q : State, q ∈ c.target → ∀ {n : ℕ} (d : Fin (n+1) → Frame M 2)
      (w : Fin (n+1) → Control 2) (G : (Fin (n+1) → Control 2) → State),
      let y := c.symm q
      x ≠ y → (∀ j, d j ∈ Γ.frames) → Joins d w x y →
      (∀ (k : ℕ) (r : Fin (k+1) → Frame M 2) (b : Fin (k+1) → Control 2),
        (∀ j, r j ∈ Γ.frames) → Joins r b x y → length w ≤ length b) →
      (∀ᶠ v in 𝓝 w, G v ∈ c.target ∧ ∀ z, Joins d v x z ↔ z = c.symm (G v)) →
      Module.finrank ℝ (LinearMap.range (fderiv ℝ G w).toLinearMap) = 3 →
      HasCostMultiplier length (fderiv ℝ G w) w := by
  obtain ⟨T,count,good⟩ := ae_countable_reference_directions Γ c hc
  obtain ⟨S,sc,atlas,cover⟩ := countable_straightening_subcover Γ c T count
  letI : Countable S := sc.to_subtype
  filter_upwards [good,ae_multiplier_in_countable_charts Γ x c hc (fun a : S => a.val)
    (fun a => atlas a.val a.property)] with q refs axes
  intro hq n d w G y distinct hd path minimal graph dim
  have cy : y ∈ c.source := c.map_target hq
  have zero : kernelRowAt G w (0 : State →L[ℝ] ℝ) = 0 := by ext h l; rfl
  have fin : FiniteDimensional ℝ (LinearMap.range (kernelRowAt G w (0 : State →L[ℝ] ℝ))) := by
    rw [zero,LinearMap.range_zero]; infer_instance
  obtain ⟨j,moving,last,dy,_⟩ := whole_third_flag_at_distinct_endpoint x y distinct c hc cy 0 n d w path G graph
    (fun _ => rfl) fin
  obtain ⟨b,bt,by',sel⟩ := refs hq
  let W := LinearMap.range (fderiv ℝ G w).toLinearMap
  obtain ⟨growth,dirs⟩ := sel (d j) (hd j) dy
  obtain ⟨i,_,out⟩ := dirs W dim.le
  let v := (thirdWord i).eval b.val.X (b.val.chart y)
  have nz : v ≠ 0 := by
    intro z
    apply out
    change (fderiv ℝ (c ∘ b.val.chart.symm) (b.val.chart y)) v ∈ W
    rw [z,map_zero]; exact W.zero_mem
  obtain ⟨a,as',ay,straight⟩ := cover b bt i y cy (rect b.val b.property i y by' nz)
  have ha := atlas a as'
  obtain ⟨l,hit⟩ := (straight y ay).2
  let P := fderiv ℝ (a ∘ c.symm) (c y)
  let D := fderiv ℝ G w
  let H := (a ∘ c.symm) ∘ G
  have atw := graph.self_of_nhds
  have base : G w = c y := (c.right_inv atw.1).symm.trans (congrArg c ((atw.2 y).mp path).symm)
  have cg := endpoint_representative_smooth d w path c hc cy G graph
  have dG := cg.differentiableAt (by decide : (1:WithTop ℕ∞) ≤ 2)
  have smooth := (transition_smooth (k := 1) c a hc ha y cy ay).differentiableAt (by decide)
  have atG : DifferentiableAt ℝ (a ∘ c.symm) (G w) := base.symm ▸ smooth
  have dH : fderiv ℝ H w = P.comp D := by rw [show H = _ from rfl,fderiv_comp w atG dG,base]
  have localH : ∀ᶠ v in 𝓝 w, H v ∈ a.target ∧ ∀ z, Joins d v x z ↔ z = a.symm (H v) := by
    have src : c.symm (G w) ∈ a.source := ((atw.2 y).mp path) ▸ ay
    filter_upwards [graph,((c.symm.continuousAt atw.1).comp dG.continuousAt)
      (a.open_source.mem_nhds src)] with u gu au
    have au' : c.symm (G u) ∈ a.source := au
    exact ⟨a.map_source au,fun z => by simpa only [H,Function.comp_apply,a.left_inv au'] using gu.2 z⟩
  obtain ⟨E,eq⟩ := ContinuousLinearMap.IsInvertible.of_inverse
    (transition_left a c ha hc y ay cy) (transition_left c a hc ha y cy ay)
  have image : LinearMap.range (fderiv ℝ H w).toLinearMap = W.map E.toLinearEquiv.toLinearMap := by
    rw [dH]; change LinearMap.range (P.toLinearMap.comp D.toLinearMap) = _
    rw [LinearMap.range_comp]
    rw [show P = E.toContinuousLinearMap from eq.symm]; rfl
  have rankH : Module.finrank ℝ (LinearMap.range (fderiv ℝ H w).toLinearMap) = 3 := by
    rw [image,E.toLinearEquiv.finrank_map_eq]; exact dim
  have chain := transition_chain b.val.chart c a b.val.compatible hc ha y by' cy ay
  let B := fderiv ℝ (c ∘ b.val.chart.symm) (b.val.chart y)
  have maps : E (B v) = Pi.single l 1 := by
    calc
      _ = P (B v) := DFunLike.congr_fun eq (B v)
      _ = _ := (DFunLike.congr_fun chain v).trans hit
  have outside : Pi.single l 1 ∉ LinearMap.range (fderiv ℝ H w).toLinearMap := by
    rw [image,← maps]
    rintro ⟨z,hz,ez⟩
    exact out ((E.injective ez) ▸ hz)
  have mem : Pi.single l 1 ∈ chartThirdLayer (d j) a y := by
    rw [← (show chartThirdLayer b.val a y = chartThirdLayer (d j) a y from
      frame_word_layer_invariant Γ b.val (d j) b.property (hd j) a ha y by' dy ay 3),← hit]
    refine ⟨v,?_,rfl⟩
    rw [← third_list]; exact Submodule.subset_span ⟨i,rfl⟩
  have support : FixedAxisMultiplierAt Γ a x (a y) := fun {N} => @axes hq (⟨a,as'⟩ : S) ay N
  obtain ⟨η,bound⟩ := support d w H (by rwa [a.left_inv ay]) hd (by rwa [a.left_inv ay])
    (by rwa [a.left_inv ay]) localH j moving last (by rwa [a.left_inv ay]) rankH
    ⟨l,by rwa [a.left_inv ay],outside⟩
  exact ⟨η.comp P,fun u => by simpa only [dH,ContinuousLinearMap.comp_apply] using bound u⟩

#print axioms ae_corank_two_of_local_straightening

end MinimizingSard.Five
