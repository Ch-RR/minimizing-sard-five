/-! Smooth equal-rank strata and the Lie algebra generated by the frame. -/
noncomputable section
open Set Filter MeasureTheory
open scoped Topology ContDiff
namespace MinimizingSard.Five
private abbrev bracket := VectorField.lieBracket (E := State) ℝ

private theorem ae_derivative_zero (f : State → State) (hf : ContDiff ℝ ∞ f) :
    ∀ᵐ x : State, f x = 0 → fderiv ℝ f x = 0 := by
  let e (j : Fin 5) : State := Pi.single j (1:ℝ)
  have comp (i : Fin 5) : ContDiff ℝ ∞ (fun x => f x i) :=
    ((ContinuousLinearMap.proj i : State →L[ℝ] ℝ).contDiff).comp hf
  have all (i j : Fin 5) := Flatness.ae_direction_zero (e j) _ (comp i)
  filter_upwards [ae_all_iff.mpr fun i => ae_all_iff.mpr (all i)] with x hx
  intro zero
  have vals (i j : Fin 5) : fderiv ℝ f x (e j) i = 0 := by
    have eq := hx i j (by simp [zero])
    let P : State →L[ℝ] ℝ := ContinuousLinearMap.proj i
    have der := P.hasFDerivAt.comp x ((hf.differentiable (by simp)) x).hasFDerivAt
    change fderiv ℝ (P ∘ f) x (e j) = 0 at eq
    rw [der.fderiv] at eq
    exact eq
  ext v i
  have dec : v = ∑ j, v j • e j := by
    ext j
    simp [e,Pi.single_apply,Finset.sum_apply]
  rw [dec,map_sum,Finset.sum_apply]
  simp [map_smul,vals]

private theorem ae_same_first_jet (S : Set State) (f g : State → State)
    (hf : ContDiff ℝ ∞ f) (hg : ContDiff ℝ ∞ g) (same : ∀ᵐ x : State, x ∈ S → f x = g x) :
    ∀ᵐ x : State, x ∈ S → fderiv ℝ f x = fderiv ℝ g x := by
  filter_upwards [same,ae_derivative_zero (f-g) (hf.sub hg)] with x h v
  intro hx
  have van := v (sub_eq_zero.mpr (h hx))
  have df := (hf.differentiable (by simp)) x
  have dg := (hg.differentiable (by simp)) x
  exact sub_eq_zero.mp (by simpa only [fderiv_sub df dg] using van)

private def tangent {r : ℕ} (S : Set State) (B : State → (Fin r → ℝ) →L[ℝ] State) (Y : State → State) :=
  ∀ᵐ x : State, x ∈ S → Y x ∈ LinearMap.range (B x).toLinearMap

/-- On a plateau of the bracket filtration, closure under horizontal
brackets of a local frame implies closure of every smooth tangent field,
even if the plateau has empty interior. -/
private theorem keeps_tangent {r : ℕ} (S : Set State) (X Y : State → State)
    (B : State → (Fin r → ℝ) →L[ℝ] State) (C : State → State →L[ℝ] (Fin r → ℝ))
    (hB : ContDiff ℝ ∞ B) (hC : ContDiff ℝ ∞ C) (hY : ContDiff ℝ ∞ Y)
    (proj : ∀ x ∈ S, ∀ v ∈ LinearMap.range (B x).toLinearMap, B x (C x v) = v)
    (basis : ∀ᵐ x : State, x ∈ S → ∀ a : Fin r → ℝ,
      bracket X (fun y => B y a) x ∈ LinearMap.range (B x).toLinearMap)
    (hy : tangent S B Y) : tangent S B (bracket X Y) := by
  let u (x : State) := C x (Y x)
  let Z (x : State) := B x (u x)
  have cu : ContDiff ℝ ∞ u := hC.clm_apply hY
  have cz : ContDiff ℝ ∞ Z := hB.clm_apply cu
  have same : ∀ᵐ x : State, x ∈ S → Z x = Y x :=
    hy.mono (fun x hx h => proj x h _ (hx h))
  filter_upwards [same,ae_same_first_jet S Z Y cz hY same,basis] with x eq de frame
  intro hx
  have fixed := frame hx (u x)
  have du := ((hB.differentiable (by simp)) x).hasFDerivAt.clm_apply
    ((cu.differentiable (by simp)) x).hasFDerivAt
  have dconst := ((hB.differentiable (by simp)) x).hasFDerivAt.clm_apply
    (hasFDerivAt_const (𝕜 := ℝ) (u x) x)
  have calcB : bracket X Y x = B x (fderiv ℝ u x (X x)) + bracket X (fun y => B y (u x)) x := by
    change fderiv ℝ Y x (X x) - fderiv ℝ X x (Y x) =
      _ + (fderiv ℝ (fun y => B y (u x)) x (X x) - fderiv ℝ X x (B x (u x)))
    rw [← de hx,← eq hx]
    change fderiv ℝ (fun y => B y (u y)) x _ - _ = _
    rw [du.fderiv,dconst.fderiv]
    simp [Z]
    abel
  rw [calcB]
  exact Submodule.add_mem _ ⟨_,rfl⟩ fixed

/-- All bracket words are tangent almost everywhere on the plateau
when the generators and their brackets with its frame are tangent. -/
theorem word_tangent_on_plateau {m r : ℕ} (S : Set State) (X : Fin m → State → State)
    (B : State → (Fin r → ℝ) →L[ℝ] State) (C : State → State →L[ℝ] (Fin r → ℝ))
    (hX : ∀ i, ContDiff ℝ ∞ (X i)) (hB : ContDiff ℝ ∞ B) (hC : ContDiff ℝ ∞ C)
    (proj : ∀ x ∈ S, ∀ v ∈ LinearMap.range (B x).toLinearMap, B x (C x v) = v)
    (gen : ∀ i, ∀ᵐ x : State, x ∈ S → X i x ∈ LinearMap.range (B x).toLinearMap)
    (basis : ∀ i, ∀ᵐ x : State, x ∈ S → ∀ a : Fin r → ℝ,
      bracket (X i) (fun y => B y a) x ∈ LinearMap.range (B x).toLinearMap)
    (w : BracketWord m) :
    ∀ᵐ x : State, x ∈ S → w.eval X x ∈ LinearMap.range (B x).toLinearMap := by
  let good (Z : State → State) := ContDiff ℝ ∞ Z ∧ tangent S B Z ∧
    ∀ Y : State → State, ContDiff ℝ ∞ Y → tangent S B Y → tangent S B (bracket Z Y)
  have induct (w : BracketWord m) : good (w.eval X) := by
    induction w with
    | field i =>
      exact ⟨hX i,gen i,fun Y hY h => keeps_tangent S (X i) Y B C hB hC hY proj (basis i) h⟩
    | bracket a b ha hb =>
      obtain ⟨ca,ta,ka⟩ := ha
      obtain ⟨cb,tb,kb⟩ := hb
      refine ⟨ca.lieBracket_vectorField cb (by simp),ka _ cb tb,?_⟩
      intro Y cy ty
      have h1 := ka _ (cb.lieBracket_vectorField cy (by simp)) (kb Y cy ty)
      have h2 := kb _ (ca.lieBracket_vectorField cy (by simp)) (ka Y cy ty)
      filter_upwards [h1,h2] with x h1 h2
      intro hx
      have eq := VectorField.leibniz_identity_lieBracket (by simp : minSmoothness ℝ 2 ≤ 2)
        ((ca.contDiffAt (x := x)).of_le (by decide))
        (cb.contDiffAt.of_le (by decide)) (cy.contDiffAt.of_le (by decide))
      change VectorField.lieBracket ℝ (VectorField.lieBracket ℝ (a.eval X) (b.eval X)) Y x ∈ _
      rw [eq_sub_of_add_eq eq.symm]
      exact Submodule.sub_mem _ (h1 hx) (h2 hx)
  exact (induct w).2.1

#print axioms word_tangent_on_plateau

private def wordCode {m : ℕ} : BracketWord m → ℕ
  | .field i => 2*i.val
  | .bracket v w => 2*Nat.pair (wordCode v) (wordCode w)+1

private theorem code_injective {m : ℕ} : Function.Injective (wordCode (m := m)) := by
  intro a b
  induction a generalizing b with
  | field i =>
    cases b with
    | field j => intro eq; change 2*i.val = 2*j.val at eq; exact congrArg BracketWord.field (Fin.ext (by omega))
    | bracket c d => simp only [wordCode]; omega
  | bracket u v hu hv =>
    cases b with
    | field j => simp only [wordCode]; omega
    | bracket c d =>
      intro eq
      simp only [wordCode] at eq
      have pair : Nat.pair (wordCode u) (wordCode v) = Nat.pair (wordCode c) (wordCode d) := by omega
      obtain ⟨one,two⟩ := Nat.pair_eq_pair.mp pair
      rw [hu one,hv two]

instance {m : ℕ} : Countable (BracketWord m) := code_injective.countable

theorem plateau_null {m r : ℕ} (S : Set State) (X : Fin m → State → State)
    (B : State → (Fin r → ℝ) →L[ℝ] State) (C : State → State →L[ℝ] (Fin r → ℝ))
    (hX : ∀ i, ContDiff ℝ ∞ (X i)) (hB : ContDiff ℝ ∞ B) (hC : ContDiff ℝ ∞ C)
    (proj : ∀ x ∈ S, ∀ v ∈ LinearMap.range (B x).toLinearMap, B x (C x v) = v)
    (gen : ∀ i, ∀ᵐ x : State, x ∈ S → X i x ∈ LinearMap.range (B x).toLinearMap)
    (basis : ∀ i, ∀ᵐ x : State, x ∈ S → ∀ a : Fin r → ℝ,
      VectorField.lieBracket ℝ (X i) (fun y => B y a) x ∈ LinearMap.range (B x).toLinearMap)
    (full : ∀ x ∈ S, Submodule.span ℝ (range (fun w : BracketWord m => w.eval X x)) = ⊤)
    (proper : ∀ x ∈ S, LinearMap.range (B x).toLinearMap ≠ ⊤) : volume S = 0 := by
  apply measure_eq_zero_iff_ae_notMem.mpr
  filter_upwards [ae_all_iff.mpr (word_tangent_on_plateau S X B C hX hB hC proj gen basis)] with x hx
  intro mem
  apply proper x mem
  apply top_unique
  rw [← full x mem]
  exact Submodule.span_le.mpr (fun _ ⟨w,eq⟩ => eq ▸ hx w mem)

#print axioms plateau_null


theorem smooth_germ_extension {G : Type*} [NormedAddCommGroup G] [NormedSpace ℝ G]
    {U : Set State} (ho : IsOpen U) {q : State} (hq : q ∈ U) (f : State → G)
    (hf : ContDiffOn ℝ ∞ f U) : ∃ g : State → G, ContDiff ℝ ∞ g ∧ g =ᶠ[𝓝 q] f := by
  obtain ⟨b,supp,_,cb,_,bq⟩ := exists_smooth_tsupport_subset (ho.mem_nhds hq)
  let a : ContDiffBump (1:ℝ) := ⟨1/4,1/2,by norm_num,by norm_num⟩
  have a0 : a 0 = 0 := a.zero_of_le_dist (by change (1/2:ℝ) ≤ dist 0 1; norm_num)
  let g (x : State) := a (b x) • f x
  have ca : ContDiff ℝ ∞ (fun x => a (b x)) := a.contDiff.comp cb
  refine ⟨g,contDiff_iff_contDiffAt.mpr ?_,?_⟩
  · intro x
    by_cases hx : x ∈ U
    · exact ca.contDiffAt.smul ((hf x hx).contDiffAt (ho.mem_nhds hx))
    · apply (contDiffAt_const (c := (0:G))).congr_of_eventuallyEq
      filter_upwards [notMem_tsupport_iff_eventuallyEq.mp (fun h => hx (supp h))] with y hy
      simp [g,hy,a0]
  · have near := (show Tendsto b (𝓝 q) (𝓝 1) by simpa only [bq] using cb.continuous.tendsto q).eventually a.eventuallyEq_one
    filter_upwards [near] with y hy
    simp [g,show a (b y) = 1 from hy]

private theorem smooth_word {m : ℕ} (X : Fin m → State → State) (cs : ∀ i, ContDiff ℝ ∞ (X i)) (w : BracketWord m) :
    ContDiff ℝ ∞ (w.eval X) := by
  induction w with
  | field i => exact cs i
  | bracket a b ha hb => exact ha.lieBracket_vectorField hb (by simp)

private def frameMap {r : ℕ} (Y : Fin r → State → State) (x : State) : (Fin r → ℝ) →L[ℝ] State :=
  ∑ j, (ContinuousLinearMap.proj j : (Fin r → ℝ) →L[ℝ] ℝ).smulRight (Y j x)

private theorem frame_apply {r : ℕ} (Y : Fin r → State → State) (x : State) (a : Fin r → ℝ) :
    frameMap Y x a = ∑ i, a i • Y i x := by simp [frameMap,ContinuousLinearMap.sum_apply]

private theorem frame_range {r : ℕ} (Y : Fin r → State → State) (x : State) :
    LinearMap.range (frameMap Y x).toLinearMap = Submodule.span ℝ (range fun j => Y j x) := by
  ext w
  rw [Submodule.mem_span_range_iff_exists_fun]
  exact exists_congr fun a => by simp [frame_apply]

private theorem frame_bracket {r : ℕ} (X : State → State) (Y : Fin r → State → State)
    (cs : ∀ i, ContDiff ℝ ∞ (Y i)) (x : State) (a : Fin r → ℝ) :
    bracket X (fun y => frameMap Y y a) x = ∑ i, a i • bracket X (Y i) x := by
  simp only [frame_apply,VectorField.lieBracket]
  have df (i : Fin r) := ((cs i).differentiable (by simp)) x
  rw [fderiv_fun_sum (u := Finset.univ) (A := fun i y => a i • Y i y) (fun i _ => (df i).const_smul (a i)),map_sum]
  have each (i : Fin r) : fderiv ℝ (fun y => a i • Y i y) x = a i • fderiv ℝ (Y i) x :=
    ((df i).hasFDerivAt.const_smul (a i)).fderiv
  simp [each,ContinuousLinearMap.sum_apply,smul_sub,Finset.sum_sub_distrib]

private theorem local_left_inverse {r : ℕ} (B : State → (Fin r → ℝ) →L[ℝ] State)
    (cs : ContDiff ℝ ∞ B) (q : State) (inj : Function.Injective (B q)) :
    ∃ C : State → State →L[ℝ] (Fin r → ℝ), ContDiff ℝ ∞ C ∧
      ∀ᶠ x in 𝓝 q, ∀ v, C x (B x v) = v := by
  obtain ⟨L0,hl⟩ := (B q).toLinearMap.exists_leftInverse_of_injective (LinearMap.ker_eq_bot.mpr inj)
  let L := L0.toContinuousLinearMap
  let T (x : State) := L.comp (B x)
  have ti : T q = 1 := ContinuousLinearMap.ext (fun v => DFunLike.congr_fun hl v)
  have ct : ContDiff ℝ ∞ T := contDiff_const.clm_comp cs
  let U := {x | IsUnit (T x)}
  have op : IsOpen U := Units.isOpen.preimage ct.continuous
  have inside : q ∈ U := by change IsUnit (T q); rw [ti]; exact isUnit_one
  let D (x : State) := (Ring.inverse (T x)).comp L
  have cd : ContDiffOn ℝ ∞ D U := by
    intro x hx
    have unit : IsUnit (T x) := hx
    have sm : ContDiffAt ℝ ∞ Ring.inverse (T x) := unit.unit_spec ▸ contDiffAt_ringInverse ℝ unit.unit
    exact ((sm.comp x ct.contDiffAt).clm_comp contDiffAt_const).contDiffWithinAt
  obtain ⟨C,cC,near⟩ := smooth_germ_extension op inside D cd
  refine ⟨C,cC,?_⟩
  filter_upwards [near,op.mem_nhds inside] with x hx mem
  intro v
  rw [hx]
  exact DFunLike.congr_fun (Ring.inverse_mul_cancel (T x) mem) v


private theorem layer_mono {m : ℕ} (X : Fin m → State → State) (q : State) {j k : ℕ} (h : j ≤ k) :
    wordLayer X q j ≤ wordLayer X q k :=
  Submodule.span_mono fun _ ⟨w,ord,eq⟩ => ⟨w,ord.trans h,eq⟩

/-- For smooth generators on Euclidean five-space, a plateau
of a fixed proper dimension has outer measure zero under pointwise
bracket generation on that plateau. -/
theorem equal_rank_set_null {m : ℕ} (S : Set State) (X : Fin m → State → State)
    (cs : ∀ i, ContDiff ℝ ∞ (X i)) (j r : ℕ) (hj : 1 ≤ j) (hr : r < 5)
    (rj : ∀ x ∈ S, Module.finrank ℝ (wordLayer X x j) = r)
    (rn : ∀ x ∈ S, Module.finrank ℝ (wordLayer X x (j+1)) = r)
    (full : ∀ x ∈ S, Submodule.span ℝ (range (fun w : BracketWord m => w.eval X x)) = ⊤) :
    volume S = 0 := by
  classical
  apply measure_null_of_locally_null
  intro q hq
  let A := {v : State | ∃ w : BracketWord m, w.order ≤ j ∧ w.eval X q = v}
  have dim : Module.finrank ℝ (Submodule.span ℝ A) = r := rj q hq
  have ex := Submodule.exists_fun_fin_finrank_span_eq ℝ A
  rw [dim] at ex
  obtain ⟨v,hv,_,ind⟩ := ex
  choose w ord eq using hv
  let Y (i : Fin r) := (w i).eval X
  let B := frameMap Y
  have smoothY (i : Fin r) := smooth_word X cs (w i)
  have cB : ContDiff ℝ ∞ B := ContDiff.sum fun i _ => contDiff_const.smulRight (smoothY i)
  have eqBasis : (fun i => Y i q) = v := funext eq
  have inj : Function.Injective (B q) := by
    intro u t same
    apply ind.fintypeLinearCombination_injective
    simpa only [B,frame_apply,Fintype.linearCombination_apply,← eqBasis] using same
  obtain ⟨C,cC,near⟩ := local_left_inverse B cB q inj
  let U := {x | ∀ v, C x (B x v) = v}
  let T := S ∩ U
  refine ⟨T,inter_mem self_mem_nhdsWithin (mem_nhdsWithin_of_mem_nhds near),?_⟩
  have rankB (x : State) (hx : x ∈ T) : Module.finrank ℝ (LinearMap.range (B x).toLinearMap) = r := by
    have inj' : Function.Injective (B x).toLinearMap := Function.LeftInverse.injective (g := C x) hx.2
    rw [LinearMap.finrank_range_of_inj inj',Module.finrank_fin_fun]
  have L (x : State) (hx : x ∈ T) : LinearMap.range (B x).toLinearMap = wordLayer X x j := by
    apply Submodule.eq_of_le_of_finrank_le _ (by rw [rankB x hx,rj x hx.1])
    rw [frame_range]
    apply Submodule.span_le.mpr
    rintro u ⟨i,rfl⟩
    exact Submodule.subset_span ⟨w i,ord i,rfl⟩
  have LL (x : State) (hx : x ∈ T) : wordLayer X x j = wordLayer X x (j+1) :=
    Submodule.eq_of_le_of_finrank_le (layer_mono X x (by omega)) (by rw [rj x hx.1,rn x hx.1])
  apply plateau_null T X B C cs cB cC
  · rintro x hx _ ⟨v,rfl⟩
    exact congrArg (B x) (hx.2 v)
  · intro i
    exact .of_forall fun x hx => (L x hx).symm ▸ Submodule.subset_span ⟨BracketWord.field i,hj,rfl⟩
  · intro i
    apply Filter.Eventually.of_forall
    intro x hx a
    rw [L x hx,LL x hx]
    change bracket (X i) (fun y => frameMap Y y a) x ∈ _
    rw [frame_bracket (X i) Y smoothY x a]
    apply Submodule.sum_mem
    intro t _
    apply Submodule.smul_mem
    apply Submodule.subset_span
    exact ⟨.bracket (.field i) (w t),by change 1+(w t).order ≤ j+1; have := ord t; omega,rfl⟩
  · exact fun x hx => full x hx.1
  · intro x hx eq
    have dim' := rankB x hx
    rw [eq,finrank_top,Module.finrank_fin_fun] at dim'
    omega

#print axioms equal_rank_set_null


private theorem words_agree {m : ℕ} {X Y : Fin m → State → State} {x : State}
    (h : ∀ i, X i =ᶠ[𝓝 x] Y i) (w : BracketWord m) : w.eval X =ᶠ[𝓝 x] w.eval Y := by
  induction w with
  | field i => exact h i
  | bracket a b ha hb => exact ha.lieBracket_vectorField hb

private theorem frame_plateau_null {m : ℕ} {M : Type*} [TopologicalSpace M] [ChartedSpace State M]
    (e : Frame M m) (j r : ℕ) (hj : 1 ≤ j) (hr : r < 5) :
    volume {x ∈ e.chart.target | Module.finrank ℝ (wordLayer e.X x j) = r ∧
        Module.finrank ℝ (wordLayer e.X x (j+1)) = r} = 0 := by
  let S := {x ∈ e.chart.target | Module.finrank ℝ (wordLayer e.X x j) = r ∧
        Module.finrank ℝ (wordLayer e.X x (j+1)) = r}
  apply measure_null_of_locally_null S
  intro q hq
  have ex (i : Fin m) := smooth_germ_extension e.chart.open_target hq.1 (e.X i) (e.smooth i)
  choose Y cs near using ex
  let U := {x : State | ∀ i, Y i =ᶠ[𝓝 x] e.X i}
  have uq : U ∈ 𝓝 q := Filter.eventually_all.mpr fun i => (near i).eventuallyEq_nhds
  let T := S ∩ U
  refine ⟨T,inter_mem self_mem_nhdsWithin (mem_nhdsWithin_of_mem_nhds uq),?_⟩
  have values (x : State) (hx : x ∈ T) (w : BracketWord m) : w.eval Y x = w.eval e.X x :=
    (words_agree hx.2 w).eq_of_nhds
  have layers (x : State) (hx : x ∈ T) (k : ℕ) : wordLayer Y x k = wordLayer e.X x k := by
    simp only [wordLayer,values x hx]
  apply equal_rank_set_null T Y cs j r hj hr
  · intro x hx
    rw [layers x hx]
    exact hx.1.2.1
  · intro x hx
    rw [layers x hx]
    exact hx.1.2.2
  · intro x hx
    simpa only [values x hx] using e.generating x hx.1.1

/-- Almost everywhere in an actual constant-rank frame of the target
specification, the bracket flag grows at every proper layer. -/
theorem ae_frame_growth {m : ℕ} {M : Type*} [TopologicalSpace M] [ChartedSpace State M] (e : Frame M m) :
    ∀ᵐ x : State, x ∈ e.chart.target → ∀ j : ℕ, 1 ≤ j →
      Module.finrank ℝ (wordLayer e.X x j) < 5 →
      Module.finrank ℝ (wordLayer e.X x j) < Module.finrank ℝ (wordLayer e.X x (j+1)) := by
  have each (j r : ℕ) : ∀ᵐ x : State, 1 ≤ j → r < 5 → x ∈ e.chart.target →
      Module.finrank ℝ (wordLayer e.X x j) = r → Module.finrank ℝ (wordLayer e.X x (j+1)) ≠ r := by
    by_cases h : 1 ≤ j ∧ r < 5
    · filter_upwards [measure_eq_zero_iff_ae_notMem.mp (frame_plateau_null e j r h.1 h.2)] with x hx
      exact fun _ _ inChart eq1 eq2 => hx ⟨inChart,eq1,eq2⟩
    · exact .of_forall (fun _ hj hr => (h ⟨hj,hr⟩).elim)
  filter_upwards [ae_all_iff.mpr fun j => ae_all_iff.mpr (each j)] with x ex
  intro mem j hj h
  exact lt_of_le_of_ne (Submodule.finrank_mono (layer_mono e.X x (Nat.le_succ j))) (ex j _ hj h mem rfl).symm

theorem ae_frame_growth_bounds {m : ℕ} {M : Type*} [TopologicalSpace M] [ChartedSpace State M] (e : Frame M m) (hm : 2 ≤ m) :
    ∀ᵐ x : State, x ∈ e.chart.target → min 5 (m+1) ≤ Module.finrank ℝ (wordLayer e.X x 2) ∧
      min 5 (m+2) ≤ Module.finrank ℝ (wordLayer e.X x 3) ∧ wordLayer e.X x 4 = ⊤ := by
  filter_upwards [ae_frame_growth e] with x h
  intro hx
  let n (j : ℕ) := Module.finrank ℝ (wordLayer e.X x j)
  have low : m ≤ n 1 := by
    have sub : Submodule.span ℝ (range (fun i => e.X i x)) ≤ wordLayer e.X x 1 := by
      apply Submodule.span_le.mpr
      rintro v ⟨i,rfl⟩
      exact Submodule.subset_span ⟨.field i,le_rfl,rfl⟩
    have bound := Submodule.finrank_mono sub
    simpa only [finrank_span_eq_card (e.independent x hx),Fintype.card_fin] using bound
  have next (j : ℕ) (hj : 1 ≤ j) : min 5 (n j+1) ≤ n (j+1) := by
    by_cases lt : n j < 5
    · exact (min_le_right _ _).trans (h hx j hj lt)
    · have mono : n j ≤ n (j+1) := Submodule.finrank_mono (layer_mono _ _ (Nat.le_succ _))
      omega
  have two : min 5 (n 1+1) ≤ n 2 := next 1 (by decide)
  have three : min 5 (n 2+1) ≤ n 3 := next 2 (by decide)
  have four : min 5 (n 3+1) ≤ n 4 := next 3 (by decide)
  refine ⟨show min 5 (m+1) ≤ n 2 by omega,show min 5 (m+2) ≤ n 3 by omega,?_⟩
  apply Submodule.eq_of_le_of_finrank_le le_top
  rw [finrank_top,Module.finrank_fin_fun]
  change 5 ≤ n 4
  omega

theorem ae_frame_step_four {M : Type*} [TopologicalSpace M] [ChartedSpace State M] (e : Frame M 2) :
    ∀ᵐ x : State, x ∈ e.chart.target → 3 ≤ Module.finrank ℝ (wordLayer e.X x 2) ∧
      4 ≤ Module.finrank ℝ (wordLayer e.X x 3) ∧ wordLayer e.X x 4 = ⊤ :=
  ae_frame_growth_bounds e (by decide)

#print axioms ae_frame_growth
#print axioms ae_frame_step_four


private theorem order_pos {m : ℕ} (w : BracketWord m) : 0 < w.order := by
  induction w with
  | field => exact Nat.one_pos
  | bracket a b ha hb => change 0 < a.order+b.order; omega

private theorem field_of_short (w : BracketWord 2) (hw : w.order ≤ 1) : ∃ i, w = .field i := by
  cases w with
  | field i => exact ⟨i,rfl⟩
  | bracket l r =>
    have := order_pos l
    have := order_pos r
    change l.order+r.order ≤ 1 at hw
    omega

theorem second_layer_le_span (X : Fin 2 → State → State) (x : State) :
    wordLayer X x 2 ≤ Submodule.span ℝ (range (![X 0 x,X 1 x,bracket (X 0) (X 1) x] : Fin 3 → State)) := by
  let b := bracket (X 0) (X 1) x
  let col : Fin 3 → State := ![X 0 x,X 1 x,b]
  let L := Submodule.span ℝ (range col)
  have gen (i : Fin 3) : col i ∈ L := Submodule.subset_span ⟨i,rfl⟩
  apply Submodule.span_le.mpr
  rintro _ ⟨w,ord,rfl⟩
  cases w with
  | field i =>
    fin_cases i
    · exact gen 0
    · exact gen 1
  | bracket l r =>
    have hl := order_pos l
    have hr := order_pos r
    change l.order+r.order ≤ 2 at ord
    obtain ⟨i,rfl⟩ := field_of_short l (by omega)
    obtain ⟨j,rfl⟩ := field_of_short r (by omega)
    change bracket (X i) (X j) x ∈ L
    fin_cases i <;> fin_cases j
    · simp [bracket,VectorField.lieBracket_self]
    · exact gen 2
    · change VectorField.lieBracket ℝ (X 1) (X 0) x ∈ L
      rw [VectorField.lieBracket_swap]
      exact L.neg_mem (gen 2)
    · simp [bracket,VectorField.lieBracket_self]

theorem second_layer_upper (X : Fin 2 → State → State) (x : State) :
    Module.finrank ℝ (wordLayer X x 2) ≤ 3 := by
  let b := bracket (X 0) (X 1) x
  let col : Fin 3 → State := ![X 0 x,X 1 x,b]
  let L := Submodule.span ℝ (range col)
  have gen (i : Fin 3) : col i ∈ L := Submodule.subset_span ⟨i,rfl⟩
  have h : wordLayer X x 2 ≤ L := second_layer_le_span X x
  exact (Submodule.finrank_mono h).trans (by simpa [L] using (finrank_range_le_card (R := ℝ) col))

theorem ae_frame_flag {M : Type*} [TopologicalSpace M] [ChartedSpace State M] (e : Frame M 2) :
    ∀ᵐ x : State, x ∈ e.chart.target → Module.finrank ℝ (wordLayer e.X x 2) = 3 ∧
      4 ≤ Module.finrank ℝ (wordLayer e.X x 3) ∧ wordLayer e.X x 4 = ⊤ := by
  filter_upwards [ae_frame_step_four e] with x hx
  intro mem
  obtain ⟨low,rest⟩ := hx mem
  exact ⟨le_antisymm (second_layer_upper e.X x) low,rest⟩

#print axioms second_layer_upper
#print axioms ae_frame_flag


/-- The step bound furnished by the actual horizontal rank in dimension five. -/
theorem ae_frame_dimension_bound {m : ℕ} {M : Type*} [TopologicalSpace M] [ChartedSpace State M]
    (e : Frame M m) : ∀ᵐ x : State, x ∈ e.chart.target → ∀ j : ℕ,
      min 5 (m+j) ≤ Module.finrank ℝ (wordLayer e.X x (j+1)) := by
  filter_upwards [ae_frame_growth e] with x grow
  intro hx
  have initial : m ≤ Module.finrank ℝ (wordLayer e.X x 1) := by
    have h : Submodule.span ℝ (range (fun i => e.X i x)) ≤ wordLayer e.X x 1 := by
      apply Submodule.span_le.mpr
      rintro _ ⟨i,rfl⟩
      exact Submodule.subset_span ⟨.field i,le_rfl,rfl⟩
    simpa only [finrank_span_eq_card (e.independent x hx),Fintype.card_fin] using Submodule.finrank_mono h
  intro j
  induction j with
  | zero => exact (min_le_right 5 m).trans initial
  | succ j ih =>
    have mono : Module.finrank ℝ (wordLayer e.X x (j+1)) ≤ Module.finrank ℝ (wordLayer e.X x (j+1+1)) :=
      Submodule.finrank_mono (layer_mono e.X x (Nat.le_succ (j+1)))
    by_cases lt : Module.finrank ℝ (wordLayer e.X x (j+1)) < 5
    · have inc := grow hx (j+1) (by omega) lt
      omega
    · omega

#print axioms ae_frame_dimension_bound

end MinimizingSard.Five
