import SobolevVelocity
import SobolevSynthesis

noncomputable section
open Set Filter MeasureTheory
open scoped Topology ContDiff
namespace MinimizingSard.Five
open Volterra
variable {M : Type*} [TopologicalSpace M] [ChartedSpace State M] {m : ℕ}

/-- The canonical absolutely continuous representative of first-order
Sobolev coordinates (initial point, ambient L² velocity). -/
def ambientPath : State × Control 5 →L[ℝ] C(Time,State) :=
  (ContinuousLinearMap.const ℝ Time).comp (ContinuousLinearMap.fst ℝ State (Control 5)) +
    ((Volterra.operator State State (ContinuousMap.const Time (ContinuousLinearMap.id ℝ State))).comp
      (frameSignal 5).toContinuousLinearEquiv.toContinuousLinearMap).comp (ContinuousLinearMap.snd ℝ State (Control 5))

theorem ambient_primitive (p : State × Control 5) :
    TimePrimitive (ambientPath p) p.1 (fun r => p.2 r) := by
  refine ⟨?_,fun t => ?_⟩
  · simpa only [ContinuousMap.const_apply,ContinuousLinearMap.id_apply,frameSignal_apply] using
      Volterra.intervalIntegrable (ContinuousMap.const Time (ContinuousLinearMap.id ℝ State)) (frameSignal 5 p.2)
  · change p.1+Volterra.operator State State (ContinuousMap.const Time (ContinuousLinearMap.id ℝ State)) (frameSignal 5 p.2) t = _
    rw [operator_eq_interval]
    simp only [ContinuousMap.const_apply,ContinuousLinearMap.id_apply,frameSignal_apply]

/-- Horizontality of actual Sobolev coordinates tests the ambient weak
velocity against the geometric horizontal space almost everywhere. -/
def Frame.HorizontalSobolev (e : Frame M m) (p : State × Control 5) : Prop :=
  (∀ t, ambientPath p t ∈ e.chart.target) ∧ ∀ᵐ r ∂controlMeasure,
    p.2 r ∈ LinearMap.range (e.coefficient (ambientPath p (clamp r))).toLinearMap

private def along {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V]
    (O : Set State) (F : State → V) (reg : ContinuousOn F O) (w : C(Time,State)) (hw : ∀ t, w t ∈ O) : C(Time,V) :=
  ⟨fun t => F (w t),reg.comp_continuous w.continuous hw⟩

theorem Frame.solve_primitive (e : Frame M m) {a : State} {u : Control m} {w : C(Time,State)}
    (hw : e.Solves u a w) : TimePrimitive w a (fun r => e.coefficient (w (clamp r)) (u r)) := by
  let B := along e.chart.target e.coefficient e.coefficient_smooth.continuousOn w hw.1
  have integr := Volterra.intervalIntegrable B (frameSignal m u)
  simp only [frameSignal_apply] at integr
  exact ⟨integr,fun t => by simpa only [frameSignal_apply] using hw.2 t⟩

/-- A single chart contains exactly the horizontal W¹,² trajectories
generated by all its original L² controls. Each such trajectory determines
its control uniquely as an L² equivalence class. -/
theorem horizontal_iff_unique_control (e : Frame M m) (p : State × Control 5) :
    e.HorizontalSobolev p ↔ ∃! u : Control m, e.Solves u p.1 (ambientPath p) := by
  let w := ambientPath p
  have prim := ambient_primitive p
  constructor
  · rintro ⟨inside,horiz⟩
    let R := along e.chart.target e.recover e.recover_smooth.continuousOn w inside
    let u := multiplyVelocity State (Fiber m) R p.2
    have eq := multiplyVelocity_ae R p.2
    have velocity : (fun r => e.coefficient (w (clamp r)) (u r)) =ᵐ[controlMeasure] (fun r => p.2 r) := by
      filter_upwards [eq,horiz] with r hr ⟨v,hv⟩
      change e.coefficient (w (clamp r)) v = p.2 r at hv
      change u r = e.recover (w (clamp r)) (p.2 r) at hr
      rw [hr,← hv,e.recover_coefficient (inside (clamp r))]
    have sol : e.Solves u p.1 w := ⟨inside,fun t => by
      simpa only [frameSignal_apply] using (prim.replace_ae velocity.symm).2 t⟩
    refine ⟨u,sol,?_⟩
    intro b hb
    let A := along e.chart.target e.coefficient e.coefficient_smooth.continuousOn w inside
    let B := multiplyVelocity (Fiber m) State A b
    have bprim : TimePrimitive w p.1 (fun r => B r) := (e.solve_primitive hb).replace_ae (multiplyVelocity_ae A b).symm
    have beq : B = p.2 := bprim.velocity_unique prim
    apply Lp.ext
    filter_upwards [multiplyVelocity_ae A b,eq] with r hr hu
    change B r = e.coefficient (w (clamp r)) (b r) at hr
    change u r = e.recover (w (clamp r)) (p.2 r) at hu
    rw [beq] at hr
    exact ((e.recover_coefficient (inside (clamp r)) (b r)).symm.trans (congrArg (e.recover (w (clamp r))) hr.symm)).trans hu.symm
  · rintro ⟨u,sol,_⟩
    let A := along e.chart.target e.coefficient e.coefficient_smooth.continuousOn w sol.1
    let B := multiplyVelocity (Fiber m) State A u
    have bprim : TimePrimitive w p.1 (fun r => B r) := (e.solve_primitive sol).replace_ae (multiplyVelocity_ae A u).symm
    have eq : B = p.2 := bprim.velocity_unique prim
    refine ⟨sol.1,?_⟩
    filter_upwards [multiplyVelocity_ae A u] with r hr
    exact ⟨u r,(show B r = _ from hr).symm.trans (congrFun (congrArg (fun v : Control 5 => (v : ℝ → State)) eq) r)⟩

/-- Every solution also supplies its unique ambient Sobolev velocity,
computed from the actual frame and the measurable control. -/
theorem solve_to_ambient (e : Frame M m) (a : State) (u : Control m) (w : C(Time,State))
    (hw : e.Solves u a w) :
    ∃! v : Control 5, ambientPath (a,v) = w := by
  let A := along e.chart.target e.coefficient e.coefficient_smooth.continuousOn w hw.1
  let v := multiplyVelocity (Fiber m) State A u
  have prim : TimePrimitive w a (fun r => v r) := (e.solve_primitive hw).replace_ae (multiplyVelocity_ae A u).symm
  refine ⟨v,?_,?_⟩
  · ext t : 1
    exact ((ambient_primitive (a,v)).2 t).trans (prim.2 t).symm
  · intro b eq
    have h := ambient_primitive (a,b)
    rw [eq] at h
    exact h.velocity_unique prim

#print axioms ambient_primitive
#print axioms horizontal_iff_unique_control
#print axioms solve_to_ambient
end MinimizingSard.Five
